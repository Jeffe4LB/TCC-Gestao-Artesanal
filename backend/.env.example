# Copie para .env e preencha. NUNCA commite o .env real.
# Gere um SECRET_KEY forte com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---------------------------------------------------------------------------
# Segurança / Django core
# ---------------------------------------------------------------------------

# Obrigatória em produção (DEBUG=False). Em dev sem chave, o backend gera uma
# chave efêmera de fallback (não use em produção).
SECRET_KEY=altere-em-producao-use-uma-string-longa-aleatoria

# Opcional: chave separada para assinar JWT. Útil para rotacionar JWT sem
# invalidar sessões do admin Django. Deve ter pelo menos 32 bytes.
# JWT_SIGNING_KEY=

# Em desenvolvimento, deixe True. Em produção, sempre False.
DEBUG=True

# Hosts/domínios permitidos. Em dev, 127.0.0.1,localhost basta.
ALLOWED_HOSTS=127.0.0.1,localhost

# Origens CORS para o front (separe por vírgula).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Domínios confiáveis para CSRF (admin Django via HTTPS). Em dev, deixe vazio
# para herdar de CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=https://app.gestao-artesanal.com.br


# ---------------------------------------------------------------------------
# Banco PostgreSQL (obrigatório)
# ---------------------------------------------------------------------------

# Opção A — variáveis separadas (desenvolvimento local):
# Crie a base antes: CREATE DATABASE gestao_artesanal;
DB_NAME=gestao_artesanal
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Opção B — URL única (Render, Railway, etc.). Se definida, substitui DB_*:
# DATABASE_URL=postgres://gestart:gestart@localhost:5432/gestao_artesanal


# ---------------------------------------------------------------------------
# SPA / links em e-mails
# ---------------------------------------------------------------------------

# URL base do front (Vite em dev: 5173). Aparece nos links dos e-mails de
# notificação e redefinição de senha. Use o IP da rede para abrir links no
# celular (não use 127.0.0.1 fora da máquina).
FRONTEND_URL=http://127.0.0.1:5173


# ---------------------------------------------------------------------------
# E-mail (notificações + redefinição de senha)
# ---------------------------------------------------------------------------

# Para desenvolvimento sem SMTP, deixe console e os e-mails caem no terminal:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Exemplo Gmail / Google Workspace UTFPR. Use SENHA DE APP (16 letras), não a
# senha da conta. Cole sem espaços.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@gestao-artesanal.local


# ---------------------------------------------------------------------------
# Recuperação de senha
# ---------------------------------------------------------------------------

PASSWORD_RESET_TOKEN_TTL=3600
PASSWORD_RESET_RATE_LIMIT_IP=20
PASSWORD_RESET_RATE_LIMIT_EMAIL=5
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600


# ---------------------------------------------------------------------------
# Throttling (DRF) — opcional, ajuste se precisar afrouxar/apertar
# ---------------------------------------------------------------------------

# Sintaxe DRF: "<num>/<periodo>" — periodo em second, minute, hour, day.
# THROTTLE_RATE_ANON=60/min
# THROTTLE_RATE_USER=300/min
# THROTTLE_RATE_LOGIN=10/min
# THROTTLE_RATE_REGISTER=20/hour
# THROTTLE_RATE_PASSWORD_RESET=5/hour


# ---------------------------------------------------------------------------
# Cache de relatórios (Fase 8)
# ---------------------------------------------------------------------------

# TTL em segundos para agregações de relatórios/dashboard (default 60).
# RELATORIO_CACHE_TTL=60

# Em produção com Redis (Render/Railway): defina a URL do serviço Redis.
# REDIS_URL=redis://localhost:6379/0

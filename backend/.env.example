# Copie para .env e preencha (nunca commite o .env).

# Mínimo ~32 caracteres para JWT (ou defina JWT_SIGNING_KEY separado).
SECRET_KEY=altere-em-producao-use-uma-string-longa-aleatoria
# JWT_SIGNING_KEY=
DEBUG=True

# PostgreSQL (obrigatório). Crie a base antes: CREATE DATABASE gestao_artesanal;
DB_NAME=gestao_artesanal
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# URL base da SPA no e-mail de redefinição. Em dev: mesmo host/porta do Vite (npm run dev → 5173).
# Se o link recusar conexão: inicie o front OU use o IP da máquina na rede (não use 127.0.0.1 no celular).
FRONTEND_URL=http://127.0.0.1:5173

# E-mail (ex.: Gmail / conta Google UTFPR — use senha de app, não a senha da conta)
DEFAULT_FROM_EMAIL=jeffersonalbuquerque@alunos.utfpr.edu.br
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_HOST_USER=jeffersonalbuquerque@alunos.utfpr.edu.br
# Obrigatório para SMTP: senha de app de 16 letras, colada SEM espaços (senha normal da conta não funciona no Gmail).
EMAIL_HOST_PASSWORD=

# Desenvolvimento sem SMTP: deixe EMAIL_BACKEND como console
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Redefinição de senha (opcional)
PASSWORD_RESET_TOKEN_TTL=3600
PASSWORD_RESET_RATE_LIMIT_IP=20
PASSWORD_RESET_RATE_LIMIT_EMAIL=5
PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
